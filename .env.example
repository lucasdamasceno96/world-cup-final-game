# ==============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to .env and fill in the values for local development.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Redis (Memorystore) Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-if-auth-enabled

# Cloud Spanner Configuration
SPANNER_PROJECT_ID=your-gcp-project-id
SPANNER_INSTANCE_ID=ticketing-instance
SPANNER_DATABASE_ID=ticketing-db

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080